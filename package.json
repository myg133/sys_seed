{
  "name": "base-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "check": "cargo check --workspace --all-targets && pnpm -r check",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "cargo test --workspace -- --test-threads=2 && pnpm -r test",
    "test:integration": "./scripts/test-integration.sh",
    "test:e2e": "playwright test --grep \"${E2E_GREP:-.}\"",
    "build": "cargo build --workspace && pnpm -r build",
    "seed": "./scripts/seed.sh",
    "disk:check": "./scripts/disk-check.sh",
    "format": "prettier --write .",
    "db:up": "./scripts/db-up.sh",
    "db:down": "./scripts/db-down.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.58.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
