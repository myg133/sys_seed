{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config": {
      "additionalProperties": {
        "properties": {
          "default": {},
          "label": {
            "type": "string"
          },
          "scope": {
            "default": "tenant",
            "enum": [
              "platform",
              "tenant",
              "space"
            ]
          },
          "type": {
            "enum": [
              "string",
              "number",
              "boolean",
              "array",
              "object"
            ]
          }
        },
        "required": [
          "type",
          "default"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "dependencies": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$",
        "type": "string"
      },
      "type": "array"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$",
      "type": "string"
    },
    "menus": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "icon": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "perm": {
            "type": "string"
          },
          "route": {
            "pattern": "^/[a-z0-9/-]*$",
            "type": "string"
          }
        },
        "required": [
          "label",
          "route"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "permissions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "condition": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": {
            "enum": [
              "menu",
              "button",
              "field",
              "data"
            ]
          }
        },
        "required": [
          "code",
          "name",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "tenantScoped": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "default": "tenant_id",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "tables": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "tables"
      ],
      "type": "object"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "enabled",
    "permissions",
    "menus",
    "dependencies"
  ],
  "title": "Base Platform Module Manifest",
  "type": "object"
}
