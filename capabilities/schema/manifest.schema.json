{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config": {
      "additionalProperties": {
        "properties": {
          "default": {},
          "label": {
            "type": "string"
          },
          "scope": {
            "default": "tenant",
            "enum": [
              "platform",
              "tenant",
              "space"
            ]
          },
          "type": {
            "enum": [
              "string",
              "number",
              "boolean",
              "array",
              "object"
            ]
          }
        },
        "required": [
          "type",
          "default"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "dependencies": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$",
        "type": "string"
      },
      "type": "array"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$",
      "type": "string"
    },
    "menus": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "icon": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "perm": {
            "type": "string"
          },
          "route": {
            "pattern": "^/[a-z0-9/-]*$",
            "type": "string"
          }
        },
        "required": [
          "label",
          "route"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "permissions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "condition": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": {
            "enum": [
              "menu",
              "button",
              "field",
              "data"
            ]
          }
        },
        "required": [
          "code",
          "name",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "api": {
            "additionalProperties": false,
            "description": "数据接口地址（D102）。list / create 必填，路径必须以 /api/ 开头。",
            "properties": {
              "create": {
                "pattern": "^/api/",
                "type": "string"
              },
              "delete": {
                "pattern": "^/api/",
                "type": "string"
              },
              "list": {
                "pattern": "^/api/",
                "type": "string"
              },
              "update": {
                "pattern": "^/api/",
                "type": "string"
              }
            },
            "type": "object"
          },
          "fields": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "key": {
                  "pattern": "^[a-z][a-zA-Z0-9]*$",
                  "type": "string"
                },
                "label": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "max": {
                  "type": "number"
                },
                "maxLength": {
                  "minimum": 0,
                  "type": "integer"
                },
                "min": {
                  "type": "number"
                },
                "minLength": {
                  "minimum": 0,
                  "type": "integer"
                },
                "pattern": {
                  "type": "string"
                },
                "permission": {
                  "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
                  "type": "string"
                },
                "readonly": {
                  "type": "boolean"
                },
                "reference": {
                  "additionalProperties": false,
                  "properties": {
                    "entity": {
                      "pattern": "^[a-z][a-zA-Z0-9]*$",
                      "type": "string"
                    },
                    "module": {
                      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "module",
                    "entity"
                  ],
                  "type": "object"
                },
                "required": {
                  "type": "boolean"
                },
                "type": {
                  "enum": [
                    "text",
                    "number",
                    "boolean",
                    "date",
                    "reference"
                  ]
                }
              },
              "required": [
                "key",
                "label",
                "type"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "label": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "label",
          "fields"
        ],
        "type": "object"
      },
      "description": "实体元数据：前端据此零代码渲染（REQ-012）。键是实体键。",
      "type": "object"
    },
    "tenantScoped": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "default": "tenant_id",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "tables": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "tables"
      ],
      "type": "object"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "enabled",
    "permissions",
    "menus",
    "dependencies"
  ],
  "title": "Base Platform Module Manifest",
  "type": "object"
}
