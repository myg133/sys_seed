{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.base.example/external-module/v1/admin.schema.json",
  "title": "Admin Surface",
  "type": "object",
  "required": ["version", "pages"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "placement", "title", "sections"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "placement": { "enum": ["app", "profile"] },
        "title": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "permission": { "type": "string" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
      }
    },
    "section": {
      "oneOf": [
        { "$ref": "#/$defs/form" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/stats" },
        { "$ref": "#/$defs/actions" },
        { "$ref": "#/$defs/tabs" }
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "config" },
            "scope": { "enum": ["platform", "tenant", "user"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "proxy" },
            "url": { "type": "string", "pattern": "^/api/" },
            "list": { "type": "string", "pattern": "^/api/" }
          }
        }
      ]
    },
    "form": {
      "type": "object",
      "required": ["component", "title", "source", "fields"],
      "additionalProperties": false,
      "properties": {
        "component": { "const": "form" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "submitLabel": { "type": "string" },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
      }
    },
    "field": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "labelKey": { "type": "string" },
        "type": {
          "enum": ["text", "textarea", "number", "integer", "boolean", "select", "date", "datetime", "stringList", "object", "array", "secretRef"]
        },
        "required": { "type": "boolean" },
        "placeholderKey": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "unit": { "type": "string" },
        "group": { "type": "string" },
        "order": { "type": "integer" },
        "advanced": { "type": "boolean" },
        "schema": { "$ref": "./config.schema.json#/$defs/objectSchema" }
      }
    },
    "table": {
      "type": "object",
      "required": ["component", "title", "source", "columns"],
      "additionalProperties": false,
      "properties": {
        "component": { "const": "table" },
        "title": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "type": { "enum": ["text", "number", "boolean", "date", "datetime"] }
            }
          }
        },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "rowActions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "method", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "permission": { "type": "string" },
              "method": { "enum": ["POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string", "pattern": "^/api/" },
              "confirm": { "type": "string" },
              "tone": { "enum": ["default", "danger"] }
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["component", "title", "source", "items"],
      "additionalProperties": false,
      "properties": {
        "component": { "const": "stats" },
        "title": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "refreshSeconds": { "type": "integer", "minimum": 5, "maximum": 3600 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "unit": { "type": "string" },
              "tone": { "enum": ["default", "warn", "danger", "success"] }
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "required": ["component", "title", "items"],
      "additionalProperties": false,
      "properties": {
        "component": { "const": "actions" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "method", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "permission": { "type": "string" },
              "method": { "enum": ["POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string", "pattern": "^/api/" },
              "confirm": { "type": "string" },
              "tone": { "enum": ["default", "danger"] }
            }
          }
        }
      }
    },
    "tabs": {
      "type": "object",
      "required": ["component", "items"],
      "additionalProperties": false,
      "properties": {
        "component": { "const": "tabs" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "sections"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
            }
          }
        }
      }
    }
  }
}
