# 底座部署配置样例（.env.example）。
#
# 用法：复制成 .env 后按环境修改。
#   cp .env.example .env
#
# ⚠️ .env 含口令，**不入库**（.gitignore 已覆盖 .env）；.env.example 入库。
# ⚠️ 生产环境用 Docker secrets / K8s Secret 注入，不要落盘明文口令。
#
# ---- 角色分工（租户隔离的前提，REQ-006）----
#
#   POSTGRES_USER（超级用户） → 建库、迁移（DDL）、建 RLS 策略
#   APP_ROLE_NAME（普通角色） → **应用连接**
#
# ⚠️ **应用连接绝不能用超级用户**：PostgreSQL 的 RLS 对超级用户与
#    `BYPASSRLS` 角色**不生效** —— 租户隔离会 fail open（数据库层兜底完全失效）。
#    应用启动时会自检连接角色：绕过 RLS 就**拒绝启动**（退出码 3）。

# ---- 私有化部署（deploy/compose.prod.yaml）必填 ----
#
# 生产库口令：**没有默认值**，缺失或为空时 compose 直接报错退出，
# 弱口令（base / postgres / password …）会被 scripts/prod-preflight.sh 拒绝。
# 生成：openssl rand -base64 24
POSTGRES_PASSWORD=
# 生产库名：compose 用它建库，必须与下面两个连接串里的库名一致。
POSTGRES_DB=base

# ---- 应用角色（普通角色，RLS 生效的前提）----
#
# 角色名：组角色 base_platform_app（NOLOGIN，持有各租户作用域表的权限）的成员。
# 生产上由 `app-role` 步骤创建（幂等）：docker compose --profile app-role run --rm app-role
APP_ROLE_NAME=base_app
# 角色口令：**没有默认值**（生产用 openssl rand -base64 24 生成）。
# 必须与下面 APP_DATABASE_URL 里的口令一致。
APP_ROLE_PASSWORD=

# ---- 连接串 ----
#
# 角色分工：
#   APP_DATABASE_URL       → **应用**连接（普通角色）—— RLS 生效的前提
#   MIGRATION_DATABASE_URL → **迁移 / 策略**连接（超级用户，需要 DDL 权限）
#
# compose 会把它们分别映射到各容器里的 DATABASE_URL（应用进程读的变量名仍是 DATABASE_URL）。
#
# 开发环境默认（compose.yaml）：
#   APP_DATABASE_URL=postgres://base_app:base@postgres:5432/base_dev
#   MIGRATION_DATABASE_URL=postgres://base:base@postgres:5432/base_dev
# 私有化部署请改成（库名必须与 POSTGRES_DB 一致）：
#   APP_DATABASE_URL=postgres://base_app:<APP_ROLE_PASSWORD>@postgres:5432/base
#   MIGRATION_DATABASE_URL=postgres://base:<POSTGRES_PASSWORD>@postgres:5432/base
#
# ⚠️ 口令里含 `/`、`@`、`:`、`#` 等 URL 保留字符时必须百分号编码（%2F、%40 …），
#    否则连接串会被截断。`openssl rand -base64 24` 的输出可能含 `/` 与 `+`。
#
# ⚠️ 下面两行里的 `base` 是**开发环境专用弱口令**（与 deploy/seed/02-app-role.sql
#    里的一致），**生产必须换成随机口令**：`openssl rand -base64 24`，
#    弱口令会被 scripts/prod-preflight.sh 直接拒绝（见 deploy/RUNBOOK.md §3.4.2）。
APP_DATABASE_URL=postgres://base_app:base@postgres:5432/base_dev
MIGRATION_DATABASE_URL=postgres://base:base@postgres:5432/base_dev

# ---- 可选 ----
# 缓存连接串（不配则不使用缓存）
REDIS_URL=redis://redis:6379

# 监听地址与端口
HOST=0.0.0.0
SERVER_PORT=8080

# 运行环境：dev | staging | prod（同一镜像靠它切分，不重新构建）
BASE_ENV=dev

# 租户隔离模式：shared | schema | database
BASE_TENANT_MODE=shared

# 日志级别：error | warn | info | debug | trace
BASE_LOG_LEVEL=info

# 认证模式：local | sso | hybrid
BASE_AUTH_MODE=local

# 启动时灌种子数据：生产必须 false（BASE_ENV=prod 时配 true 会直接启动失败）
BASE_SEED_ON_START=false

# 迁移目录（镜像内默认 /app/migrations）
BASE_MIGRATIONS_DIR=./migrations

# 前端静态资源目录（镜像内默认 /app/static）；留空表示不托管前端
BASE_STATIC_DIR=./static

# 允许用**绕过 RLS 的角色**（超级用户 / BYPASSRLS）启动：**仅本地开发**。
# 默认 false —— 生产配置 true 会直接启动失败（BASE_ENV=prod 时被禁止）。
BASE_ALLOW_SUPERUSER=false

# 租户作用域声明的根目录（其下是 modules/<模块>/manifest.json）；
# `base tenant-policies` 按它生成 RLS 策略。镜像内默认 /app。
BASE_MANIFEST_ROOT=.

# ---- 认证与账号体系（REQ-007）----
#
# ⚠️ **一个都没配** → 平台**不提供** `/api/iam/*` 认证接口（服务照常起）。
# ⚠️ **配了一部分** → 配置必须完整有效，否则**启动失败**（退出码 2）：
#    密钥缺失、是占位符（changeme / replace_me / example …）一律拒绝。
#
# 密钥**只从环境注入**，不入库不入 Git。

# JWT 签名密钥（P-256 / PKCS#8 的 PEM）：**必填**。
# 生成：`openssl ecparam -genkey -noout -name prime256v1 | openssl pkcs8 -topk8 -nocrypt`
#     再转成 PKCS#8：`openssl pkcs8 -topk8 -nocrypt -in ec.pem -out jwt.pem`
BASE_JWT_PRIVATE_KEY=
# 当前密钥的 kid（客户端按 kid 选密钥；轮换时换 kid）：**必填**。
BASE_JWT_KID=
# 上一把密钥（**轮换宽限期**：新旧 kid 同时有效）：可选，两项要成对出现。
BASE_JWT_PREVIOUS_PRIVATE_KEY=
BASE_JWT_PREVIOUS_KID=
# 签发者 / 受众：可选（默认 base / base-api）。
BASE_JWT_ISSUER=base
BASE_JWT_AUDIENCE=base-api

# TOTP secret 静态加密的密钥（base64url，32 字节）：**必填**。
# 生成：`openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`
BASE_IAM_SECRET_KEY=

# 令牌有效期（秒）：可选（默认 access 900 / refresh 2592000 / reset 3600）。
BASE_IAM_ACCESS_TTL_SECONDS=900
BASE_IAM_REFRESH_TTL_SECONDS=2592000
BASE_IAM_RESET_TTL_SECONDS=3600

# Argon2id 参数：可选（默认 19456 KiB / t=2 / p=1，即 OWASP 推荐下限）。
# ⚠️ 低配机可调小 m 与 t，但**生产必须给足**（参数写在 PHC 串里，可随时调）。
BASE_IAM_ARGON2_MEMORY_KIB=19456
BASE_IAM_ARGON2_ITERATIONS=2
BASE_IAM_ARGON2_PARALLELISM=1

# 密码策略：可选（默认最小长度 12 / 有效期 180 天 / 历史 5 条）。
BASE_IAM_PASSWORD_MIN_LENGTH=12
BASE_IAM_PASSWORD_MAX_AGE_DAYS=180
BASE_IAM_PASSWORD_HISTORY=5

# 登录限流与账号锁定：可选（默认 IP 20 次/5 分钟、账号失败 5 次锁 15 分钟）。
BASE_IAM_LOGIN_IP_LIMIT=20
BASE_IAM_LOGIN_IP_WINDOW_SECONDS=300
BASE_IAM_LOGIN_ACCOUNT_LIMIT=5
BASE_IAM_ACCOUNT_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# REQ-008：用户与组织架构（SCIM 出站 / LDAP 入站）
# ---------------------------------------------------------------------------
# ⚠️ **一个都不配 → 不提供同步能力**（服务照常起，组织树本身不依赖任何外部系统）。

# SCIM 出站目标：provider 标识与目标地址。
# ⚠️ 本期**只支持 http://** —— 树里没有 TLS 栈；填 https 会明确报「本期未实现」，
#    不会静默降级成明文。
BASE_ORG_SCIM_PROVIDER=default
BASE_ORG_SCIM_BASE_URL=

# SCIM 认证头（整行，形如 `Authorization: Bearer xxx`）。
BASE_ORG_SCIM_AUTH_HEADER=

# SCIM 字段映射（JSON）：不同 IdP 的用户名 / 邮箱 / 显示名字段名不同。
# 例：{"userFields":{"username":"login","email":"workEmail","displayName":"cn","emailShape":"single"}}
BASE_ORG_SCIM_MAPPING=

# LDAP / AD 入站源的映射配置（JSON）：
#   {"source":"corp-ad","baseDn":"DC=corp,DC=example,DC=com","filter":"(objectClass=user)",
#    "attributes":{"external_id":"objectGUID","username":"sAMAccountName","email":"mail",
#                  "displayName":"displayName","department":"department",
#                  "disabled":{"op":"bit_and","attr":"userAccountControl","mask":2}}}
# ⚠️ `disabled` 用**位运算表达式**（AD 的 userAccountControl 是位标志，不是布尔）。
# ⚠️ 本期**只支持明文 ldap://**。
BASE_ORG_LDAP_SOURCE=

# 同步冲突策略：manual（默认，绝不静默覆盖）/ local_wins / remote_wins。
BASE_ORG_CONFLICT_STRATEGY=manual
