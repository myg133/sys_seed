{
  "id": "config",
  "name": "配置与品牌",
  "version": "0.1.0",
  "enabled": true,
  "permissions": [
    { "code": "config:entry:write", "name": "写租户级/空间级配置", "type": "button" },
    { "code": "config:flag:write", "name": "改功能开关", "type": "button" },
    { "code": "config:platform:write", "name": "写平台级配置", "type": "button" },
    { "code": "config:platform:read", "name": "读平台级配置", "type": "button" }
  ],
  "menus": [],
  "dependencies": [],
  "config": {
    "locale": {
      "type": "string",
      "default": "zh-CN",
      "scope": "tenant",
      "label": "界面语言（已注册语言之一）",
      "format": "locale"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Shanghai",
      "scope": "tenant",
      "label": "时区（IANA 名）",
      "format": "iana-timezone"
    },
    "currency": {
      "type": "string",
      "default": "CNY",
      "scope": "tenant",
      "label": "币种（ISO 4217）",
      "format": "iso4217"
    },
    "logo": {
      "type": "string",
      "default": "/branding/default.svg",
      "scope": "space",
      "label": "Logo 路径"
    },
    "favicon": {
      "type": "string",
      "default": "/favicon-default.svg",
      "scope": "space",
      "label": "站点图标路径"
    },
    "title": {
      "type": "string",
      "default": "示例平台",
      "scope": "space",
      "label": "站点标题"
    },
    "loginBackground": {
      "type": "string",
      "default": "",
      "scope": "space",
      "label": "登录页背景"
    },
    "footer": {
      "type": "string",
      "default": "示例平台",
      "scope": "space",
      "label": "页脚文案"
    },
    "copyright": {
      "type": "string",
      "default": "© 2026",
      "scope": "space",
      "label": "版权信息"
    },
    "primaryColor": {
      "type": "string",
      "default": "#111111",
      "scope": "space",
      "label": "主色"
    },
    "theme.radius": {
      "type": "number",
      "default": 4,
      "scope": "space",
      "label": "圆角（px）"
    },
    "theme.mode": {
      "type": "string",
      "default": "light",
      "scope": "space",
      "label": "颜色模式"
    },
    "theme.density": {
      "type": "string",
      "default": "comfortable",
      "scope": "space",
      "label": "组件密度"
    },
    "theme.fontStack": {
      "type": "array",
      "default": ["system-ui"],
      "scope": "space",
      "label": "字体栈"
    },
    "loginBanner": {
      "type": "string",
      "default": "",
      "scope": "space",
      "label": "登录页横幅（登记为 space 但**不在**品牌白名单内 —— D66 的判据夹具）"
    },
    "theme.tokens": {
      "type": "object",
      "default": {},
      "scope": "tenant",
      "label": "主题令牌（对象类型）"
    },
    "newInvoice": {
      "type": "boolean",
      "default": false,
      "scope": "tenant",
      "label": "新发票功能开关"
    },
    "beta": {
      "type": "boolean",
      "default": false,
      "scope": "tenant",
      "label": "Beta 功能开关（配合派生键做灰度）"
    },
    "sso.enforce": {
      "type": "boolean",
      "default": false,
      "scope": "tenant",
      "label": "强制 SSO（开启后禁用本地密码登录）"
    },
    "sso.jitProvisioning": {
      "type": "boolean",
      "default": false,
      "scope": "tenant",
      "label": "首次 SSO 登录时自动建号"
    },
    "sso.oidc.enabled": {
      "type": "boolean",
      "default": false,
      "scope": "tenant",
      "label": "启用 OIDC 单点登录"
    },
    "sso.oidc.issuer": {
      "type": "string",
      "default": "",
      "scope": "tenant",
      "label": "OIDC IdP 的 issuer（用于发现文档）"
    },
    "sso.oidc.clientId": {
      "type": "string",
      "default": "",
      "scope": "tenant",
      "label": "OIDC client_id（非敏感）"
    },
    "sso.oidc.scopes": {
      "type": "string",
      "default": "openid email profile",
      "scope": "tenant",
      "label": "OIDC scope（空格分隔）"
    },
    "sso.oidc.redirectUri": {
      "type": "string",
      "default": "",
      "scope": "tenant",
      "label": "OIDC 回调地址（绝对 URL，须与 IdP 登记逐字一致）"
    },
    "sso.ldap.enabled": {
      "type": "boolean",
      "default": false,
      "scope": "tenant",
      "label": "启用 LDAP 登录"
    },
    "sso.ldap.url": {
      "type": "string",
      "default": "",
      "scope": "tenant",
      "label": "LDAP 地址（本轮只支持 ldap://）"
    },
    "sso.ldap.baseDn": {
      "type": "string",
      "default": "",
      "scope": "tenant",
      "label": "LDAP 检索根（Base DN）"
    },
    "sso.ldap.userSearchFilter": {
      "type": "string",
      "default": "(uid={username})",
      "scope": "tenant",
      "label": "LDAP 用户检索过滤器（必须含 {username} 占位符）"
    },
    "sso.ldap.mailAttribute": {
      "type": "string",
      "default": "mail",
      "scope": "tenant",
      "label": "映射到本地账号的属性名"
    },
    "audit.retention.onlineDays": {
      "type": "number",
      "default": 90,
      "scope": "platform",
      "label": "审计在线保留天数（超期记录由归档搬进归档表；本轮只登记，不自动执行）"
    },
    "audit.retention.archiveDays": {
      "type": "number",
      "default": 365,
      "scope": "platform",
      "label": "审计归档保留天数（归档记录物理删除的阈值；本轮只登记，不执行）"
    },
    "audit.page.defaultSize": {
      "type": "number",
      "default": 20,
      "scope": "platform",
      "label": "审计列表默认每页条数"
    },
    "audit.page.maxSize": {
      "type": "number",
      "default": 200,
      "scope": "platform",
      "label": "审计列表每页条数上限（登记值；与契约 C7 的上限一致）"
    }
  }
}
