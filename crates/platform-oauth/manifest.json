{
  "id": "oauth",
  "name": "出站 IdP",
  "version": "0.1.0",
  "enabled": true,
  "permissions": [
    { "code": "oauth:client:read", "name": "查看 OAuth 客户端", "type": "menu" },
    { "code": "oauth:client:write", "name": "管理 OAuth 客户端", "type": "button" },
    { "code": "oauth:client:delete", "name": "删除 OAuth 客户端", "type": "button" },
    { "code": "oauth:grant:read", "name": "查看授权记录", "type": "menu" },
    { "code": "oauth:grant:revoke", "name": "撤销授权", "type": "button" },
    { "code": "oauth:token:introspect", "name": "内省令牌", "type": "button" }
  ],
  "menus": [
    { "label": "授权管理", "icon": "key", "route": "/oauth/grants", "perm": "oauth:grant:read" }
  ],
  "tenantScoped": {
    "tables": [
      "platform_oauth_grant",
      "platform_oauth_code",
      "platform_oauth_device_code",
      "platform_oauth_token"
    ],
    "column": "tenant_id"
  },
  "dependencies": [],
  "config": {
    "oauth.frontendBaseUrl": {
      "type": "string",
      "default": "",
      "scope": "platform",
      "label": "授权页前端基址"
    },
    "oauth.accessTokenTtlSeconds": {
      "type": "number",
      "default": 3600,
      "scope": "platform",
      "label": "访问令牌有效期（秒）"
    },
    "oauth.authorizationCodeTtlSeconds": {
      "type": "number",
      "default": 60,
      "scope": "platform",
      "label": "授权码有效期（秒）"
    },
    "oauth.deviceCodeTtlSeconds": {
      "type": "number",
      "default": 600,
      "scope": "platform",
      "label": "设备码有效期（秒）"
    },
    "oauth.deviceCodePollIntervalSeconds": {
      "type": "number",
      "default": 5,
      "scope": "platform",
      "label": "设备码轮询间隔（秒）"
    }
  }
}
